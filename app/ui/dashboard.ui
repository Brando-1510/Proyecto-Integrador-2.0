            <property name="styleSheet">
             <string notr="true">QComboBox {
    /* Fondo claro y bordes muy redondeados */
    background-color: #F8F9FA;
    border: 1px solid transparent; /* O un gris muy tenue si lo deseas */
    border-radius: 12px;
    
    /* Espaciado interno: arriba, derecha, abajo, izquierda */
    padding: 8px 30px 8px 12px;
    
    /* Tipografía y color del texto */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
    color: #000000;
}

/* Espacio reservado para el botón de la flecha */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 0px; /* Quita la línea divisoria por defecto */
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* Icono de la flecha hacia abajo minimalista */
QComboBox::down-arrow {
    image: url(:icons/chevron.svg); /* Usa un PNG gris tenue como el de la imagen */
    width: 12px;
    height: 12px;
}

/* Estilo opcional para cuando el usuario pasa el mouse por encima */
QComboBox:hover {
    background-color: #F1F3F5;
}
</string>
