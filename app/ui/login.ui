                 </property>

                 <property name="placeholderText">
                  <string>Crea una nueva Contraseña</string>
                 </property>

                </widget>

               </item>

              </layout>

             </item>


             <!-- CONFIRMAR CONTRASEÑA -->

             <item>

              <layout class="QVBoxLayout" name="confirmPasswordLayout">

               <property name="spacing">
                <number>6</number>
               </property>

               <item>

                <widget class="QLabel" name="lblConfirmarContrasena">

                 <property name="text">
                  <string>Repite tu Contraseña</string>
                 </property>

                 <property name="texto" stdset="0">
                  <string>InputTexto</string>
                 </property>

                </widget>

               </item>


               <item>

                <widget class="QLineEdit" name="txtConfirmarContrasena">

                 <property name="sizePolicy">
                  <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                   <horstretch>0</horstretch>
                   <verstretch>0</verstretch>
                  </sizepolicy>
                 </property>

                 <property name="minimumSize">
                  <size>
                   <width>0</width>
                   <height>40</height>
                  </size>
                 </property>

                 <property name="echoMode">
                  <enum>QLineEdit::Password</enum>
                 </property>

                 <property name="placeholderText">
                  <string>Confirma tu Contraseña</string>
                 </property>

                </widget>

               </item>

              </layout>

             </item>


             <!-- BOTÓN CAMBIAR -->

             <item>

              <layout class="QHBoxLayout" name="changePasswordButtonLayout">

               <item>

                <spacer name="changePasswordLeftSpacer">

                 <property name="orientation">
                  <enum>Qt::Horizontal</enum>
                 </property>

                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>40</width>
                   <height>20</height>
                  </size>
                 </property>

                </spacer>

               </item>


               <item>

                <widget class="QPushButton" name="btnCambiarContrasena">

                 <property name="minimumSize">
                  <size>
                   <width>180</width>
                   <height>40</height>
                  </size>
                 </property>

                 <property name="maximumSize">
                  <size>
                   <width>250</width>
                   <height>40</height>
                  </size>
                 </property>

                 <property name="text">
                  <string>Realizar Cambio</string>
                 </property>

                 <property name="boton" stdset="0">
                  <string>Primario</string>
                 </property>

                </widget>

               </item>


               <item>

                <spacer name="changePasswordRightSpacer">

                 <property name="orientation">
                  <enum>Qt::Horizontal</enum>
                 </property>

                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>40</width>
                   <height>20</height>
                  </size>
                 </property>

                </spacer>

               </item>

              </layout>

             </item>

            </layout>

           </widget>

          </item>

         </layout>

        </widget>

       </widget>

      </item>

     </layout>

    </widget>

   </item>

  </layout>

 </widget>


