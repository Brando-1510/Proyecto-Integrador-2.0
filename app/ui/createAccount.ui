   <property name="styleSheet">
    <string notr="true">/* Estilos generales del Aside */
QLabel {
    color: #F7F7F7;
    qproperty-alignment: 'AlignHCenter | AlignVCenter';
    font-size: 16px;
}

QLabel[styleClass=&quot;tituloPrincipal&quot;] {
    font-weight: bold;
    font-size: 22px;
	font-family: &quot;Manrope&quot;; 
}

QLabel[styleClass=&quot;tituloSeccion&quot;] {
    font-weight: bold;
    font-size: 24px;
	font-family: &quot;Manrope&quot;; 
}

QLabel[styleClass=&quot;numeroPaso&quot;] {
    background-color: #00A86B;
    border: 0px;
    border-radius: 25px;
    color: white;
    font-weight: bold;
    font-size: 14px;
    min-width: 50px;
    max-width: 50px;
    min-height: 50px;
    max-height: 50px;
    qproperty-alignment: 'AlignCenter';
}</string>
   </property>
   <property name="frameShape">
    <enum>QFrame::StyledPanel</enum>
   </property>
   <property name="frameShadow">
