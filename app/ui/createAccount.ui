   <string notr="true">#LoginWindow{
background-color: #f7f7f7;
}
/*
-----------------------------------------------------------------------------------------------------
Inputs
-----------------------------------------------------------------------------------------------------*/
/* --- ESTADO BASE --- */
QLineEdit, QDateEdit {
    background-color: #F8F9FA; 
    border: 2px solid #D1D5DB; 
    border-radius: 8px;     
    padding: 8px 12px;         
    color: #0E042F;
}

/* --- CUANDO EL MOUSE ESTÁ ENCIMA (HOVER) --- */
QLineEdit:hover, QDateEdit:hover {
    border: 1px solid #9CA3AF;      /* Borde un poco más oscuro */
    background-color: #F3F4F6;      /* Fondo ligeramente gris */
}

/* --- CUANDO TIENE EL FOCO / SE ESTÁ ESCRIBIENDO (FOCUS) --- */
QLineEdit:focus, QDateEdit:focus {
    border: 1px solid #744bcc;      /* Borde azul más grueso */
    background-color: #FFFFFF;      /* Fondo blanco puro */
}

/* --- CUANDO EL CAMPO ESTÁ DESHABILITADO (DISABLED) --- */
QLineEdit:disabled, QDateEdit:disabled {
    background-color: #E5E7EB;      /* Fondo gris oscuro */
    color: #9CA3AF;                 /* Texto gris claro */
    border:2px solid #D1D5DB;      /* Borde original o más claro */
}

/* --- ESTILO ESPECÍFICO PARA EL BOTÓN DE FLECHA EN QDATEEDIT --- */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #D1D5DB;
    border-left-style: solid;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
/*
-----------------------------------------------------------------------------------------------------
Textos
-----------------------------------------------------------------------------------------------------*/
QLabel{
font-size: 14px;
color: #0E042F;
}
QLabel[texto=&quot;TituloPrincipal&quot;]{
font-size:30px;
qproperty-alignment: 'AlignCenter';
font-weight:bold;
}
QLabel[texto=&quot;Descripcion&quot;]{
font-size:18px;
color: #6C6686;
}
QLabel[texto=&quot;InputTexto&quot;]{
font-size:16px;
color: #6C6686;
}
QLabel[texto=&quot;Destacado&quot;]{
font-size:16px;
color: #0E042F;
qproperty-alignment: 'AlignCenter';
font-weight: bold;
}
/*
-----------------------------------------------------------------------------------------------------
Botones
-----------------------------------------------------------------------------------------------------*/
/* --- BOTÓN PRIMARIO --- */
QPushButton[boton=&quot;Primario&quot;] {
    border-radius: 10px;
    background-color: #5D38BB;
    font-weight: bold;
    color: #f7f7f7;
    font-size: 12pt;
}

QPushButton[boton=&quot;Primario&quot;]:hover {
    background-color: #744bcc;
}

QPushButton[boton=&quot;Primario&quot;]:pressed {
    background-color: #472a8f;
}


/* --- BOTÓN SECUNDARIO --- */
QPushButton[boton=&quot;Secundario&quot;] {
    border-radius: 10px;
    background-color: rgba(161, 147, 204, 0.7);
    font-weight: bold;
    color: #5D38BB;
    font-size: 18px;
}

QPushButton[boton=&quot;Secundario&quot;]:hover {
    background-color: rgba(161, 147, 204, 0.9); 
}

QPushButton[boton=&quot;Secundario&quot;]:pressed {
    background-color: rgba(131, 117, 174, 0.9);
}
/* --- BOTÓN TEXTO --- */
QPushButton[boton=&quot;BotonTexto&quot;] {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
    color: #0E042F;
    font-weight: bold;
	font-size: 16px;
}

/* Evita que cambie de estilo o muestre bordes al pasar el mouse, hacer clic o tener el foco */
QPushButton[boton=&quot;BotonTexto&quot;]:hover {
    color: #6C6686;
    background: transparent;
}

QPushButton[boton=&quot;BotonTexto&quot;]:pressed,
QPushButton[boton=&quot;BotonTexto&quot;]:focus {
    border: none;
    background: transparent;
    outline: none;
}
</string>
