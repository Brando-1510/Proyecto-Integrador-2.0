   <property name="styleSheet">
    <string notr="true">/* Estilos generales del Aside */
QLabel {
    color: #F7F7F7;
    qproperty-alignment: 'AlignHCenter | AlignVCenter';
    font-size: 14pt;
}

QLabel[styleClass=&quot;tituloPrincipal&quot;] {
    font-weight: bold;
    font-size: 20pt;
}

QLabel[styleClass=&quot;tituloSeccion&quot;] {
    font-weight: bold;
    font-size: 16pt;
}

QLabel[styleClass=&quot;numeroPaso&quot;] {
    background-color: #00A86B;
    border: 0px;
    border-radius: 25px;
    color: white;
    font-weight: bold;
    font-size: 14pt;
    min-width: 50px;
    max-width: 50px;
    min-height: 50px;
    max-height: 50px;
    qproperty-alignment: 'AlignCenter';
}

QLabel[styleClass=&quot;textoPaso&quot;] {
    font-size: 14pt;
}
</string>
   </property>

   <property name="frameShape">
