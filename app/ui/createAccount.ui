  <property name="styleSheet">
   <string notr="true">/* Fondo general */
QWidget#paginaRegistro {
    background-color: #F3F4F6;
}

/* Aside */
QFrame#frameAside {
    background-color: #16094C;
}

/* Todos los labels normales */
QLabel {
    background-color: transparent;
}
QLabel[styleClass=&quot;tituloPrincipal&quot;] {
    font-weight: bold;
    font-size: 30px;
	color: #0E042F
}

QLabel[styleClass=&quot;tituloSecundario&quot;] {
    font-size: 20px;
	color: #6C6686;
}
QLabel[styleClass=&quot;numeroPaso&quot;] {
    background-color: #FFFEFE;
    border: 2px solid #B9B7A7;
    /* 1. Cambia el radio a la mitad del nuevo tamaño */
    border-radius: 32px; 
    color: #252525;
    font-weight: bold;
    /* 2. Sube el tamaño de la fuente si lo necesitas */
    font-size: 18px; 
    /* 3. Aumenta las dimensiones del elemento */
    min-width: 64px;
    max-width: 64px;
    min-height: 64px;
    max-height: 64px;
    qproperty-alignment: 'AlignCenter';
}

QLabel[paso=&quot;PasoActivo&quot;]{
    background-color: #5D38BB;
    color: #252525;
 	border: 0px;
}
QLabel[paso=&quot;PasoCompletado&quot;]{
    background-color: #279D4F;
    color: #252525;
 	border: 0px;
}
QLineEdit {
    background-color: #F8F9FA; 
    border: 1px solid #D1D5DB; 
    border-radius: 8px;     
    padding: 8px 12px;         
    color: #333333;          
}
QDateEdit {
    background-color: #F8F9FA; 
    border: 1px solid #D1D5DB; 
    border-radius: 8px;     
    padding: 8px 12px;         
    color: #333333;          
}
QLabel[styleClass=&quot;circuloDescripcion&quot;] {
    border: 5px solid #279D4F;
    border-radius: 25px;
    color: #D1D5DB;
    qproperty-alignment: 'AlignCenter';
}
</string>
  </property>
