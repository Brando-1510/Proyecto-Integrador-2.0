  <property name="styleSheet">
   <string notr="true">/*
-----------------------------------------------------------------------------------------------------
Fondos
-----------------------------------------------------------------------------------------------------*/
QWidget#CrearCuenta{
background-color: #F4F5F7;
}
/*
-----------------------------------------------------------------------------------------------------
Textos
-----------------------------------------------------------------------------------------------------*/
QLabel{
font-size: 14px;
color: #0E042F;
}
QLabel[texto=&quot;TituloPrincipal&quot;]{
font-size:26px;
qproperty-alignment: 'AlignCenter';
font-weight:bold;
}
QLabel[texto=&quot;Descripcion&quot;]{
font-size:18px;
color: #6C6686;
}
QLabel[texto=&quot;Destacado&quot;]{
font-size:20px;
color: #0E042F;
font-weight: bold;
}
/*
-----------------------------------------------------------------------------------------------------
Inputs
-----------------------------------------------------------------------------------------------------*/
/* --- ESTADO BASE --- */
QLineEdit, QDateEdit,QComboBox {
    background-color: #F8F9FA; 
    border: 2px solid #D1D5DB; 
    border-radius: 8px;     
    padding: 8px 12px;         
    color: #0E042F;      
	font-size:12px; 
}

/* --- CUANDO EL MOUSE ESTÁ ENCIMA (HOVER) --- */
QLineEdit:hover, QDateEdit:hover, QComboBox:hover {
    border: 1px solid #9CA3AF;      /* Borde un poco más oscuro */
    background-color: #F3F4F6;      /* Fondo ligeramente gris */
}

/* --- CUANDO TIENE EL FOCO / SE ESTÁ ESCRIBIENDO (FOCUS) --- */
QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #744bcc;      /* Borde azul más grueso */
    background-color: #FFFFFF;      /* Fondo blanco puro */
}

/* --- CUANDO EL CAMPO ESTÁ DESHABILITADO (DISABLED) --- */
QLineEdit:disabled, QDateEdit:disabled, QComboBox:disabled {
    background-color: #E5E7EB;      /* Fondo gris oscuro */
    color: #9CA3AF;                 /* Texto gris claro */
    border: 2px solid #D1D5DB;      /* Borde original o más claro */
}

/* --- ESTILO ESPECÍFICO PARA EL BOTÓN DE FLECHA EN QDATEEDIT --- */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #D1D5DB;
    border-left-style: solid;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/*----- ESTILOS DE LOS QComboBox -----*/
/* --- BOTÓN DE LA FLECHA (DROP-DOWN) --- */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px; /* Quita el borde interno */
    border-top-right-radius: 8px; /* Mantiene el redondeado del contenedor */
    border-bottom-right-radius: 8px;
}

/* --- ICONO DE LA FLECHA --- */
QComboBox::down-arrow {
   image: url(:/icons/chevron.svg);
    width: 12px;
    height: 12px;
}

/* --- EL MENÚ DESPLEGABLE (LISTA DE OPCIONES) --- */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 2px solid #744bcc; /* Borde que combina con tu Focus */
    border-radius: 8px;
    padding: 4px;
    color: #0E042F;
    selection-background-color: #744bcc; /* Fondo al pasar el mouse en la lista */
    selection-color: #FFFFFF; /* Texto al pasar el mouse en la lista */
}


/*
-----------------------------------------------------------------------------------------------------
Botones
-----------------------------------------------------------------------------------------------------*/
/* --- BOTÓN PRIMARIO --- */
QPushButton[boton=&quot;Primario&quot;] {
    border-radius: 10px;
    background-color: #5D38BB;
    font-weight: bold;
    color: #f7f7f7;
    font-size: 12pt;
}

QPushButton[boton=&quot;Primario&quot;]:hover {
    background-color: #744bcc;
}

QPushButton[boton=&quot;Primario&quot;]:pressed {
    background-color: #472a8f;
}


/* --- BOTÓN SECUNDARIO --- */
QPushButton[boton=&quot;Secundario&quot;] {
    border-radius: 10px;
    background-color: rgba(161, 147, 204, 0.7);
    font-weight: bold;
    color: #5D38BB;
    font-size: 18px;
}

QPushButton[boton=&quot;Secundario&quot;]:hover {
    background-color: rgba(161, 147, 204, 0.9); 
}

QPushButton[boton=&quot;Secundario&quot;]:pressed {
    background-color: rgba(131, 117, 174, 0.9);
}
</string>
