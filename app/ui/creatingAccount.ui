    <string notr="true">QLabel[styleClass=&quot;numeroPaso&quot;] {
    background-color: #FFFEFE;
    border: 2px solid #B9B7A7;
    /*Cambia el radio a la mitad del tamaño */
    border-radius: 32px; 
    color: #252525;
    font-weight: bold;
    font-size: 18px; 
    /* 3. Aumenta las dimensiones del elemento */
    min-width: 64px;
    max-width: 64px;
    min-height: 64px;
    max-height: 64px;
    qproperty-alignment: 'AlignCenter';
}
QLabel[paso=&quot;Activo&quot;]{
background-color: #5D38BB;
border: 0px;
}
QLabel[paso=&quot;Completado&quot;]{
