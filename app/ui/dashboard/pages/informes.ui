     <property name="styleSheet">
      <string notr="true">/* --- ESTADO BASE --- */
QLineEdit, QDateEdit, QPlainTextEdit, QComboBox {
    background-color: #F8F9FA; 
    border: 1px solid #D1D5DB; 
    border-radius: 8px;     
    padding: 8px 12px;         
    color: #333333;          
}

/* --- CUANDO EL MOUSE ESTÁ ENCIMA (HOVER) --- */
QLineEdit:hover, QDateEdit:hover, QPlainTextEdit:hover, QComboBox:hover {
    border: 1px solid #9CA3AF;
    background-color: #F3F4F6;
}

/* --- CUANDO TIENE EL FOCO / SE ESTÁ ESCRIBIENDO (FOCUS) --- */
QLineEdit:focus, QDateEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 2px solid #744bcc;
    background-color: #FFFFFF;
}

/* --- CUANDO EL CAMPO ESTÁ DESHABILITADO (DISABLED) --- */
QLineEdit:disabled, QDateEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    background-color: #E5E7EB;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

/* --- ESTILO ESPECÍFICO PARA EL BOTÓN DE FLECHA EN QDATEEDIT --- */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #D1D5DB;
    border-left-style: solid;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* Estilo base para el QCheckBox y su texto */
QCheckBox {
    spacing: 8px;                 /* Espacio entre el cuadro y el texto */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Mismo estilo de fuente limpio */
    font-size: 14px;
    color: #252525;               /* Tu color de texto oscuro */
}

/* Estado al pasar el mouse por encima de la etiqueta */
QCheckBox:hover {
    color: #4A148C;               /* El texto se torna ligeramente morado al pasar el mouse */
}

/* Estado cuando el checkbox está deshabilitado */
QCheckBox:disabled {
    color: #aaaaaa;
}

/* Estilo del cuadro (indicador) */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #D1D1D6;    /* Gris suave que combina con tus inputs */
    border-radius: 5px;           /* Esquinas sutilmente redondeadas */
    background-color: #ffffff;
}

/* Cuadro cuando se pasa el mouse por encima (Hover) */
QCheckBox::indicator:hover {
    border-color: #5E2BFF;        /* Borde morado intermedio al posicionarse encima */
    background-color: #F9F6FF;    /* Destello de fondo morado muy claro */
}
/* Cuadro cuando está marcado (Checked) utilizando el archivo QRC */
QCheckBox::indicator:checked {
    border-color: #5E2BFF;        /* Borde con tu morado principal */
    background-color: #5E2BFF;    /* Fondo con tu morado principal */
    image: url(:/icons/checkIcon.svg); /* Ruta absoluta del recurso QRC */
}

/* Cuadro marcado cuando se pasa el mouse por encima */
QCheckBox::indicator:checked:hover {
    border-color: #4A148C;        
    background-color: #4A148C;
    image: url(:/icons/checkIcon.svg); /* Mantenemos el icono en el hover */
}



/* Cuadro marcado cuando se pasa el mouse por encima */
QCheckBox::indicator:checked:hover {
    border-color: #4A148C;        /* Un morado más oscuro al hacer hover sobre el check activo */
    background-color: #4A148C;
}
/* Cuadro cuando está marcado (Checked) */
QCheckBox::indicator:checked {
    border-color: #5E2BFF;        /* Borde con tu morado principal */
    background-color: #5E2BFF;    /* Fondo con tu morado principal */
}

/* --- ESTILO DEL QCOMBOBOX --- */
QComboBox {
    background-color: #F8F9FA;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 12px;
    padding-right: 30px;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #9CA3AF;
    background-color: #F3F4F6;
}

QComboBox:focus {
    border: 2px solid #744bcc;
    background-color: #FFFFFF;
}

QComboBox:disabled {
    background-color: #E5E7EB;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

/* --- BOTÓN DE DESPLEGAR --- */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #D1D5DB;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* --- FLECHA --- */
QComboBox::down-arrow {
    image: url(:/icons/chevron.svg);
    width: 12px;
    height: 12px;
}
/* --- LISTA DESPLEGABLE DEL QCOMBOBOX --- */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 4px;
    color: #333333;
    selection-background-color: #744bcc;
    selection-color: #FFFFFF;
}

/* --- HOVER DE LOS ELEMENTOS DEL QCOMBOBOX --- */
QComboBox QAbstractItemView::item:hover {
    background-color: #F3F4F6;
    color: #333333;
}
/*
-----------------------------------------------------------------------------------------------------
Botones
-----------------------------------------------------------------------------------------------------*/
QPushButton{
width:300px;
height:50px;
}
/* --- BOTÓN PRIMARIO --- */
QPushButton[boton=&quot;Primario&quot;] {
    border-radius: 10px;
    background-color: #5D38BB;
    font-weight: bold;
    color: #f7f7f7;
    font-size: 12pt;
}

QPushButton[boton=&quot;Primario&quot;]:hover {
    background-color: #744bcc;
}

QPushButton[boton=&quot;Primario&quot;]:pressed {
    background-color: #472a8f;
}


/* --- BOTÓN SECUNDARIO --- */
QPushButton[boton=&quot;Secundario&quot;] {
    border-radius: 10px;
    background-color: rgba(161, 147, 204, 0.7);
    font-weight: bold;
    color: #5D38BB;
    font-size: 18px;
}

QPushButton[boton=&quot;Secundario&quot;]:hover {
    background-color: rgba(161, 147, 204, 0.9); 
}

QPushButton[boton=&quot;Secundario&quot;]:pressed {
    background-color: rgba(131, 117, 174, 0.9);
}
/* --- BOTÓN TEXTO --- */

QPushButton[boton=&quot;BotonTexto&quot;] {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
    color: #0E042F;
    font-weight: bold;
    font-size: 16px;
}

QPushButton[boton=&quot;BotonTexto&quot;]:hover {
    color: #6C6686;
    background: transparent;
}

QPushButton[boton=&quot;BotonTexto&quot;]:pressed,
QPushButton[boton=&quot;BotonTexto&quot;]:focus {
    border: none;
    background: transparent;
    outline: none;
}

</string>
