                <property name="styleSheet">
                 <string notr="true">/* Estado: Archivo Válido (Verde) */
QFrame[carta=&quot;Valido&quot;] {
    background-color: #e6f7ed;  /* Fondo verde claro */
    border: 1px solid #a3e2bc;   /* Borde verde suave (opcional) */
    color: #1e7e34;              /* Texto o contenido en verde oscuro */
 border-radius: 12px;
}

/* Estado: Error (Rojo) */
QFrame[carta=&quot;Error&quot;] {
    background-color: #fce8e6;  /* Fondo rojo claro */
    border: 1px solid #f5c2c7;   /* Borde rojo suave (opcional) */
    color: #dc3545;              /* Texto o contenido en rojo oscuro */
 border-radius: 12px;
}
/* --- ESTILOS DE LOS QLABEL DEPENDIENDO DEL CONTENEDOR --- */

/* Cuando el Frame está en modo 'Valido', pinta su QLabel de verde oscuro */
QFrame[carta=&quot;Valido&quot;] QLabel {
    color: #2e7d32;
	font-weight:bold;
    font-size: 16px;
}

/* Cuando el Frame está en modo 'Error', pinta su QLabel de rojo oscuro */
QFrame[carta=&quot;Error&quot;] QLabel {
    color: #c62828;
    font-size: 16px;
}
</string>
