   <string notr="true">QFrame[carta=&quot;Dashboard&quot;] {
    background-color: #FFFFFF;
    border: 1px solid #E4E0EA;
    border-radius: 12px;
}
#CargarDatos{
background-color:#f7f7f7;
}
QFrame{
background-color:#f7f7f7;
}

/*
-----------------------------------------------------------------------------------------------------
Textos
-----------------------------------------------------------------------------------------------------*/
QLabel{
background-color: transparent;
font-size: 14px;
color: #0E042F;
}
QLabel[texto=&quot;InputTexto&quot;]{
font-size: 16px;
font-weight: bold;
}
QLabel[texto=&quot;TituloPrincipal&quot;]{
font-size:22px;
font-weight:bold;
}
