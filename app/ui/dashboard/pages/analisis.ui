        <property name="styleSheet">
         <string notr="true">/* Estilo base para todas las cápsulas */
QLabel[tipo=&quot;capsula&quot;] {
    font-weight: bold;
    font-size: 14px;
    padding: 4px 12px;       /* Espaciado interno (arriba/abajo, lados) */
    border-radius: 10px;     /* Hace las esquinas completamente redondas */
    border-width: 1px;
    border-style: solid;
}

/* Cápsula dentro de la carta de atención */
QFrame[carta=&quot;atencion&quot;] QLabel[tipo=&quot;capsula&quot;] {
    background-color: #FFE3E6;
    border-color: #FFA3A8;
    color: #D9383A;
}

/* Cápsula dentro de la carta de buen comportamiento */
QFrame[carta=&quot;bueno&quot;] QLabel[tipo=&quot;capsula&quot;] {
    background-color: #E2F7EB;
    border-color: #9CE7BA;
    color: #1A874B;
}

/* Cápsula dentro de la carta para considerar */
QFrame[carta=&quot;considerar&quot;] QLabel[tipo=&quot;capsula&quot;] {
    background-color: #FFF2D6;
    border-color: #FED48C;
    color: #B27000;
}

</string>
