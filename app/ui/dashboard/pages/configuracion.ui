             <property name="styleSheet">
              <string notr="true">QTabWidget {
		background-color:#f7f7f7;
    }
QTabWidget::pane {
    border: none;
    background-color: #f7f7f7;
}
QTabWidget &gt; QWidget {
    background-color: #f7f7f7;
	background-color:transparent;
}
QTabBar::tab {
    background: #F1EFF6;
    color: #46315c;
    padding: 10px 28px;

    border: none;
    border-radius: 8px;

    margin-right: 6px;
	min-width: 50px; 
    font-family: &quot;Manrope&quot;;
    font-size: 14px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #E8E5F0;
    color: #16094C;
}

QTabBar::tab:selected {
    background: #16094C;
    color: white;
}

/* Configuración general de la tabla */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E0EA;
    border-radius: 10px;
    gridline-color: #EAE7EF;
    font-size: 14px;
    color: #0E042F;
    selection-background-color: #EEEAF5;
    selection-color: #0E042F;
}

/* Encabezados (Horizontal y Vertical) */
QTableWidget QHeaderView::section {
    background-color: #F5F3F8;
    color: #0E042F;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #E4E0EA;
    padding: 10px;
}

/* Contenedor del encabezado */
QHeaderView {
    background-color: #F5F3F8;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}

/* Celdas individuales */
QTableWidget::item {
    padding: 8px;
    border: none;
}

/* Fila/Celda seleccionada */
QTableWidget::item:selected {
    background-color: #EEEAF5;
    color: #0E042F;
}

/* Esquina superior izquierda (intersección de encabezados) */
QTableWidget QTableCornerButton::section {
    background-color: #F5F3F8;
    border: none;
    border-top-left-radius: 9px;
}

/* --- SCROLLBAR VERTICAL --- */
QTableWidget QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 2px 4px 2px;
}

QTableWidget QScrollBar::handle:vertical {
    background-color: #C9C1D5;
    border-radius: 4px;
    min-height: 30px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background-color: #B4A9C4;
}

/* Ocultar botones/flechas del scrollbar vertical */
QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical,
QTableWidget QScrollBar::add-page:vertical,
QTableWidget QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

/* --- SCROLLBAR HORIZONTAL --- */
QTableWidget QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 2px 4px 2px 4px;
}

QTableWidget QScrollBar::handle:horizontal {
    background-color: #C9C1D5;
    border-radius: 4px;
    min-width: 30px;
}

QTableWidget QScrollBar::handle:horizontal:hover {
    background-color: #B4A9C4;
}

/* Ocultar botones/flechas del scrollbar horizontal */
QTableWidget QScrollBar::add-line:horizontal,
QTableWidget QScrollBar::sub-line:horizontal,
QTableWidget QScrollBar::add-page:horizontal,
QTableWidget QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}
