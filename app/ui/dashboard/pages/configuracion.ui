       <property name="styleSheet">
        <string notr="true">/*
-----------------------------------------------------------------------------------------------------
ScrollArea
-----------------------------------------------------------------------------------------------------
*/
#scrollAreaWidgetContents {
    background-color: transparent;
}
QScrollArea {
    background-color: transparent;
    border: none;
	border-radius:0px;
}

/* Widget que está dentro del ScrollArea */
/*QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #F9F9FC;
}*/

/* Scrollbar vertical */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
}

/* Parte que se puede arrastrar */
QScrollBar::handle:vertical {
    background-color: #C9C1D5;
    border-radius: 4px;
    min-height: 40px;
}

/* Al pasar el mouse */
QScrollBar::handle:vertical:hover {
    background-color: #A99DB8;
}

/* Ocultar botones de arriba y abajo */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Espacio antes/después del handle */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
