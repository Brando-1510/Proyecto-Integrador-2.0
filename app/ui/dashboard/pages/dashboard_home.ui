                <property name="styleSheet">
                 <string notr="true">QTabWidget {
        qproperty-expanding: true;
		background-color:#f7f7f7;
    }
QTabWidget::pane {
    border: none;
    background-color: #f7f7f7;
}
QTabWidget &gt; QWidget {
    background-color: #f7f7f7;
}
QTabBar::tab {
    background: #F1EFF6;
    color: #46315c;

    padding: 10px 28px;

    border: none;
    border-radius: 8px;

    margin-right: 6px;
	min-width: 50px; 
    font-family: &quot;Manrope&quot;;
    font-size: 14px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #E8E5F0;
    color: #16094C;
}

QTabBar::tab:selected {
    background: #16094C;
    color: white;
}
