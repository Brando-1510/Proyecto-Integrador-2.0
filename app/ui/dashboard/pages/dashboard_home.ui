   <string notr="true">QFrame[carta=&quot;Dashboard&quot;] {
    background-color: #FFFFFF;
    border: 1px solid #E4E0EA;
    border-radius: 12px;
}
#DashboardPage{
background-color:#f7f7f7;
}
QFrame{
background-color:#f7f7f7;
}

/*
-----------------------------------------------------------------------------------------------------
Textos
-----------------------------------------------------------------------------------------------------*/
QLabel{
background-color: transparent;
font-size: 14px;
color: #0E042F;
}
QLabel[texto=&quot;InputTexto&quot;]{
font-size: 16px;
font-weight: bold;
}
QLabel[texto=&quot;TituloPrincipal&quot;]{
font-size:20px;
font-weight:bold;
}
QLabel[texto=&quot;Valor&quot;]{
font-size:20px;
}
QLabel[texto=&quot;TituloSecundario&quot;]{
font-size:18px;
font-weight:bold;
}
QLabel[texto=&quot;Descripcion&quot;]{
font-size:16px;
color: #46315c;
}
QLabel[texto=&quot;Destacado&quot;]{
font-size:16px;
color: #0E042F;
font-weight: bold;
}
</string>
