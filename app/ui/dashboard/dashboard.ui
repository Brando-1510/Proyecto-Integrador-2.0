/*------------------------------------------------------------------------------------
QLabels
---------------------------------------------------------------------------------------*/
QLabel{
color:#f7f7f7;
font-size:14px;
}
QLabel[texto=&quot;tituloAside&quot;]{
font-weight:bold;
font-size:18px;
}
QLabel[texto=&quot;Destacado&quot;]{
font-weight:bold;
font-size:16px;
}

/*--------------------------------------------------------------------------------
QPushButton 
----------------------------------------------------------------------------------*/
/* Estilo general para todos los botones del menú */
QPushButton {
    background-color: transparent; /* Fondo transparente por defecto */
    color: #ffffff;               /* Texto blanco */
    font-size: 16px;              /* Tamaño de fuente */
    text-align: left;             /* Alinea icono y texto a la izquierda */
    padding-left: 15px;           /* Separación con el borde izquierdo */
    border: none;                 /* Quita el borde por defecto */
    border-radius: 8px;           /* Bordes redondeados */
    height: 40px;                 /* Altura del botón */

}

/* Efecto al pasar el cursor por encima (Hover) */
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1); 
}

/* Estado activo/seleccionado (como el botón &quot;Home&quot; morado) */
QPushButton:checked, QPushButton:pressed {
    background-color: #5d51f2;    /* Color morado de tu imagen */
}

/*---------------------------
Widgets
*------------*/
#promotionalFrame{
background-color: #311B6E;
border: 2px solid rgba(161, 147, 204, 0.7);
border-radius: 15px;
}

