  <property name="styleSheet">
   <string notr="true">QDialog{
background-color:#f7f7f7;
}
QLabel{
background-color: transparent;
font-size: 14px;
color: #0E042F;
}
QLabel[texto=&quot;InputTexto&quot;]{
font-size: 16px;
font-weight: bold;
}
QLabel[texto=&quot;TituloPrincipal&quot;]{
font-size:20px;
font-weight:bold;
}
QLabel[texto=&quot;Valor&quot;]{
font-size:20px;
}
QLabel[texto=&quot;TituloSecundario&quot;]{
font-size:16px;
font-weight:bold;
}
QLabel[texto=&quot;Descripcion&quot;]{
font-size:16px;
color: #46315c;
}
QLabel[texto=&quot;Destacado&quot;]{
font-size:16px;
color: #0E042F;
font-weight: bold;
}
/*Botones*/
/* --- BOTÓN PRIMARIO --- */

QPushButton[boton=&quot;Primario&quot;] {
    border-radius: 10px;
    background-color: #5D38BB;
    font-weight: bold;
    color: #F7F7F7;
    font-size: 12pt;
    min-height: 40px;
    padding-left: 20px;
    padding-right: 20px;
	width: 200px;
}

QPushButton[boton=&quot;Primario&quot;]:hover {
    background-color: #744BCC;
}

QPushButton[boton=&quot;Primario&quot;]:pressed {
    background-color: #472A8F;
}

/* --- BOTÓN SECUNDARIO --- */

QPushButton[boton=&quot;Secundario&quot;] {
    border-radius: 10px;
    background-color: rgba(161, 147, 204, 0.7);
    font-weight: bold;
    color: #5D38BB;
    font-size: 18px;
    min-height: 40px;
}

QPushButton[boton=&quot;Secundario&quot;]:hover {
    background-color: rgba(161, 147, 204, 0.9);
}

QPushButton[boton=&quot;Secundario&quot;]:pressed {
    background-color: rgba(131, 117, 174, 0.9);
}
/* --- BOTÓN TEXTO --- */

QPushButton[boton=&quot;BotonTexto&quot;] {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
    color: #0E042F;
    font-weight: bold;
    font-size: 16px;
}

QPushButton[boton=&quot;BotonTexto&quot;]:hover {
    color: #6C6686;
    background: transparent;
}

QPushButton[boton=&quot;BotonTexto&quot;]:pressed,
QPushButton[boton=&quot;BotonTexto&quot;]:focus {
    border: none;
    background: transparent;
    outline: none;
}

/*
-----------------------------------------------------------------------------------------------------
Inputs
-----------------------------------------------------------------------------------------------------*/
/* --- ESTADO BASE --- */
QLineEdit, QDateEdit, QPlainTextEdit, QComboBox {
    background-color: #F8F9FA; 
    border: 1px solid #D1D5DB; 
    border-radius: 8px;     
    padding: 8px 12px;         
    color: #333333;          
}

/* --- CUANDO EL MOUSE ESTÁ ENCIMA (HOVER) --- */
QLineEdit:hover, QDateEdit:hover, QPlainTextEdit:hover, QComboBox:hover {
    border: 1px solid #9CA3AF;
    background-color: #F3F4F6;
}

/* --- CUANDO TIENE EL FOCO / SE ESTÁ ESCRIBIENDO (FOCUS) --- */
QLineEdit:focus, QDateEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 2px solid #744bcc;
    background-color: #FFFFFF;
}

/* --- CUANDO EL CAMPO ESTÁ DESHABILITADO (DISABLED) --- */
QLineEdit:disabled, QDateEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    background-color: #E5E7EB;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

/* --- ESTILO ESPECÍFICO PARA EL BOTÓN DE FLECHA EN QDATEEDIT --- */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #D1D5DB;
    border-left-style: solid;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* --- ESTILO DEL QCOMBOBOX --- */
QComboBox {
    background-color: #F8F9FA;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 12px;
    padding-right: 30px;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #9CA3AF;
    background-color: #F3F4F6;
}

QComboBox:focus {
    border: 2px solid #744bcc;
    background-color: #FFFFFF;
}

QComboBox:disabled {
    background-color: #E5E7EB;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

/* --- BOTÓN DE DESPLEGAR --- */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #D1D5DB;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* --- FLECHA --- */
QComboBox::down-arrow {
    image: url(:/icons/chevron.svg);
    width: 12px;
    height: 12px;
}
/* --- LISTA DESPLEGABLE DEL QCOMBOBOX --- */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 4px;
    color: #333333;
    selection-background-color: #744bcc;
    selection-color: #FFFFFF;
}

/* --- HOVER DE LOS ELEMENTOS DEL QCOMBOBOX --- */
QComboBox QAbstractItemView::item:hover {
    background-color: #F3F4F6;
    color: #333333;
}


    /* =========================
       BOTONES DE QMESSAGEBOX
    ========================= */
  QInputDialog QPushButton {
    font-size: 12px;
    font-weight: bold;

    color: #F7F7F7;
    background-color: #5D38BB;

    border: none;
    border-radius: 5px;

    min-width: 80px;
    max-width: 120px;

    min-height: 28px;
    max-height: 28px;

    padding: 0px;
}

QInputDialog QPushButton:hover {
    background-color: #744BCC;
}

QInputDialog QPushButton:pressed {
    background-color: #472A8F;
}</string>
