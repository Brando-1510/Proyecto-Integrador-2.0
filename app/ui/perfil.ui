     <property name="styleSheet">
      <string notr="true">QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabWidget &gt; QWidget {
    background-color: transparent;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: #79668E;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
   
    min-width: 180px; 
    
    margin-right: 0px; /* Cambiar a 0px ayuda a que no queden huecos feos */
    font-family: &quot;Manrope&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    font-weight: 600;
}


QTabBar::tab:hover {
    color: #16094C;
    border-bottom: 2px solid #D6CEE5; /* Línea tenue al pasar el ratón */
}

QTabBar::tab:selected {
    background: transparent;
    color: #16094C; /* Púrpura oscuro para texto activo */
    border-bottom: 3px solid #16094C; /* Indicador de línea activa */
}</string>
