            <property name="styleSheet">
             <string notr="true">/* 1. Contenedor principal del ScrollArea */
QScrollArea {
    border: none;                  /* Sin bordes molestos alrededor */
    background-color: #F3F3F3;     /* Fondo gris claro idéntico al de la imagen */
}

/* 2. El widget interno que sostiene las tarjetas */
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #F3F3F3;     /* Mantiene el fondo gris claro */
}

/* 3. Barra de desplazamiento Vertical Minimalista */
QScrollBar:vertical {
    background: transparent;       /* Sin fondo para que no ensucie la interfaz */
    width: 8px;                    /* Delgada y moderna */
    margin: 4px 2px 4px 2px;
}

/* 4. El &quot;Tirador&quot; o barra móvil */
QScrollBar::handle:vertical {
    background-color: #A0A0A0;     /* Gris suave discreto */
    min-height: 30px;
    border-radius: 4px;            /* Totalmente redondeado */
}

/* Cuando el mouse pasa por encima se vuelve un poco más oscuro */
QScrollBar::handle:vertical:hover {
    background-color: #787878;
}

/* 5. Eliminar por completo las flechas de arriba y abajo */
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    background: none;
}

/* 6. Espacio vacío del fondo del scroll tracking */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
</string>
            </property>
